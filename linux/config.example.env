# Copy to $ULTRON_HOME/config.env (e.g. /workspace/ultron/config.env) and fill in. setup.sh and ultron-linux read it.
# Never commit the real file: it holds secrets.

# Hugging Face read token. Accept the licences on huggingface.co first for: Lightricks/LTX-2.5 (gated),
# Qwen/Qwen-Image-2.1, fishaudio/s2-pro.
HF_TOKEN=

# What to install. Profiles: voice (default: latentsync,fish,chatterbox,asr,qwen3tts) | full (adds ltx, qwen_image, music,
# hyperframes). ULTRON_COMPONENTS overrides the profile with an exact comma list; all components:
# ltx,qwen_image,qwen_image_turbo,music,fish,chatterbox,qwen3tts,asr,latentsync,hyperframes
ULTRON_PROFILE=voice
ULTRON_COMPONENTS=

# Connector secret (the long code in the connector URL). Leave empty to generate one; it is saved in
# $ULTRON_HOME/secrets/mcp_token, so with a persistent volume the URL stays the same every day.
ULTRON_MCP_TOKEN=

# HTTPS tunnel: cloudflare (quick, new address each start) | cloudflare-named | runpod | none
ULTRON_TUNNEL=cloudflare
# for cloudflare-named: a tunnel token from Cloudflare Zero Trust > Networks > Tunnels, routed to http://localhost:8765
CLOUDFLARE_TUNNEL_TOKEN=
ULTRON_PUBLIC_URL=

# Optional fast daily restore when the box has no persistent disk: an rclone remote holding a copy of the weights
# (Cloudflare R2 has free egress). First day: ULTRON_WEIGHTS_MIRROR_PUSH=1 to upload after the HF download.
# rclone reads its remote from env, e.g. RCLONE_CONFIG_R2_TYPE=s3 RCLONE_CONFIG_R2_PROVIDER=Cloudflare
# RCLONE_CONFIG_R2_ACCESS_KEY_ID=... RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=... RCLONE_CONFIG_R2_ENDPOINT=https://<acct>.r2.cloudflarestorage.com
ULTRON_WEIGHTS_MIRROR=
ULTRON_WEIGHTS_MIRROR_PUSH=0
# Personal inputs (my_voice_ref.wav + my_voice_ref.txt, source_clip.mp4) pulled into the avatar inputs folder
ULTRON_ASSETS_REMOTE=
# Where `ultron-linux sync-outputs` copies results before you delete the box
ULTRON_OUTPUTS_REMOTE=

# Memory policy for the diffusion workers: auto | none (80 GB cards) | model (24-48 GB) | group (smaller)
ULTRON_OFFLOAD=auto
# Unload the model after N idle seconds (0 = keep it loaded)
CUDA_SERVE_IDLE_UNLOAD=0
